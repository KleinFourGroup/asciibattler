        {
          "kind": "hook",
          "on": "dealHit",
          "filter": { "archetype": "rogue" },
          "effect": {
            "op": "gainBits",
            "amount": 1
          }
        }
      ]
    },
    {
      "id": "cornucopia",
      "name": "The Cornucopia",
