      "rules": [
        {
          "kind": "modifier",
          "stat": "recruitOfferSize",
          "op": "add",
          "value": 1
        }
      ]
    },
    {
      "id": "patricians-seal",
      "name": "Patrician's Seal",
      "description": "Common units no longer appear in draft pools.",
      "rules": [
        {
          "kind": "modifier",
          "stat": "rarityWeightCommon",
          "op": "mult",
          "value": 0
        }
      ]
    },
    {
      "id": "portunus",
      "name": "Key of Portunus",
      "description": "Ports always stock a legendary unit.",
      "rules": [
        {
          "kind": "modifier",
          "stat": "portLegendaryOffers",
          "op": "add",
          "value": 1
        }
      ]
    },
    {
      "id": "fortuna",
      "name": "Wheel of Fortuna",
