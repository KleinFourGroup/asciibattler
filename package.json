{
  "name": "asciibattler",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/dev-scan.mjs dist",
    "preview": "vite preview",
    "shell": "electron shell/electron",
    "record": "node shell/electron/record-cli.mjs",
    "probe": "node shell/electron/probe-cli.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fuzz": "tsx tests/fuzz/cli.ts",
    "fuzz:smoke": "vitest run --config vitest.fuzz.config.ts --exclude tests/fuzz/parallelRunDecisions.test.ts --exclude tests/fuzz/corpus/corpus.test.ts",
    "fuzz:jobs-parity": "vitest run --config vitest.fuzz.config.ts tests/fuzz/parallelRunDecisions.test.ts",
    "balance:board": "tsx tests/fuzz/board/cli.ts",
    "prior:table": "tsx tests/fuzz/prior/cli.ts",
    "roster:table": "tsx tests/fuzz/roster/cli.ts",
    "gauntlet": "tsx tests/gauntlet/cli.ts",
    "pathing": "tsx tests/pathing/cli.ts",
    "board-geometry": "tsx tests/board/cli.ts",
    "nodemap:metrics": "tsx tools/nodemap-viz/report.ts",
    "run-config": "tsx tools/run-config/cli.ts",
    "gen:sfx": "node scripts/gen-sfx.mjs",
    "trace-mine": "tsx tests/gauntlet/traceMine.ts",
    "gen:font": "tsx scripts/build-font.mjs",
    "i18n:extract": "tsx scripts/i18n-extract.ts",
    "i18n:baseline": "tsx scripts/i18n-baseline.ts",
    "i18n:review": "tsx scripts/i18n-review.ts",
    "save:fingerprint": "tsx scripts/save-fingerprint.ts",
    "replay": "tsx scripts/replay.ts",
    "chaos": "tsx tests/chaos/cli.ts",
    "corpus": "tsx tests/fuzz/corpus/cli.ts",
    "oracle": "tsx tests/oracle/cli.ts",
    "dist:hash": "node scripts/dist-hash.mjs",
    "papercut": "node scripts/papercut.mjs",
    "phase-stats": "node scripts/phase-stats.mjs",
    "friction-scan": "node scripts/friction-scan.mjs"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "44.9.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": false
  }
}
