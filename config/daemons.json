        {
          "kind": "modifier",
          "stat": "bitsGain",
          "op": "mult",
          "value": 1.2
        }
      ]
    },
    {
      "id": "laverna",
      "name": "Cloak of Laverna",
      "description": "Each blow a rogue lands earns a bit.",
