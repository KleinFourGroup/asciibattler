[
  {
    "id": "corrupted-shrine",
    "name": "Suspicious Shrine",
    "entry": "start",
    "pages": {
      "start": {
        "text": "You come across a small, rundown shrine on the side of the road.  A shimmering pile of bits lies in the shrine's offering bowl, though the nearest hop is at least a day away.",
        "choices": [
          {
            "id": "scoop-the-bowl",
            "label": "Take the bits.",
            "outcomes": [
              {
                "weight": 3,
                "effects": [{ "op": "gainBits", "amount": 12 }],
                "next": "loot"
              },
              { "weight": 1, "next": "guardians" }
            ]
          },
          {
            "id": "make-an-offering-10-bits",
            "label": "Make your own offering.",
            "condition": { "kind": "bitsAtLeast", "amount": 10 },
            "outcomes": [
              {
                "effects": [
                  { "op": "spendBits", "amount": 10 },
                  { "op": "healPool", "amount": 5 }
                ],
                "next": "heal"
              }
            ]
          },
          {
            "id": "pass-by",
            "label": "Keep walking.",
            "outcomes": [{ "next": "nope" }]
          }
        ]
      },
      "guardians": {
        "text": "A band of deserters pop into existence in a burst of static.  They look mightily confused, as if the shrine's idol hadn't warned them.  Unfortunately for you, their blades are already drawn.",
        "choices": [
          {
            "id": "stand-and-fight",
            "label": "We can take them!",
            "outcomes": [
              {
                "next": {
                  "kind": "start-encounter",
                  "encounterId": "deserters",
                  "rewardOverride": [{ "table": "bits-large", "trigger": { "chance": 1 } }]
                }
              }
            ]
          },
          {
            "id": "scatter-and-run",
            "label": "This is bad news.",
            "outcomes": [
              {
                "effects": [{ "op": "damagePool", "amount": 3 }],
                "next": "nope"
              }
            ]
          }
        ]
      },
      "heal": {
        "text": "The static noise gently descends upon you and your men, and it feels... Soothing.",
        "choices": [
          {
            "id": "leave",
            "label": "What a pleasant turn of events!",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      },
      "nope": {
        "text": "You and your men calmly yet quickly march away from the shrine.",
        "choices": [
          {
            "id": "leave",
            "label": "Let's skedaddle!",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      },
      "loot": {
        "text": "You brace for retaliation from the shrine, but none comes.",
        "choices": [
          {
            "id": "leave",
            "label": "We were being paranoid.",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      }
    }
  },
  {
    "id": "whispering-terminal",
    "name": "The Haunted Terminal",
    "entry": "start",
    "pages": {
      "start": {
        "text": "While exploring an abandoned building, you and your men find a decaying computer lab.  Suddenly, one of the screens lights up.\n\nA GIFT, it prints, FOR A FAVOR?",
        "choices": [
          {
            "id": "type-your-name",
            "label": "Try to input your name.",
            "outcomes": [
              {
                "effects": [
                  { "op": "setFlag", "flag": "whispering-terminal:answered" },
                  { "op": "addPacket", "packetId": "shield" }
                ],
                "next": "favor"
              }
            ]
          },
          {
            "id": "unplug-it",
            "label": "Shut it down.",
            "outcomes": [{ "next": "flee" }]
          }
        ]
      },
      "favor": {
        "text": "A packet coheres into existence in a burst of static.  You take it.",
        "choices": [
          {
            "id": "leave",
            "label": "What could it want in return?",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      },
      "flee": {
        "text": "The monitor stays lit, unfazed by the loss of power.  This is too much for your men, who stampede out of the room.",
        "choices": [
          {
            "id": "leave",
            "label": "It's not a retreat!  We're advancing backwards.",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      }
    }
  },
  {
    "id": "whispering-terminal-collects",
    "name": "The Haunted Terminal, Part Two",
    "eligibility": [{ "kind": "flagSet", "flag": "whispering-terminal:answered" }],
    "entry": "start",
    "pages": {
      "start": {
        "text": "You awaken to the sound of your men screaming!  A terminal has popped into existence right in the middle of your camp!\n\nOUR FAVOR IS DUE, it types out, as a pile of golden bits falls to the ground.",
        "choices": [
          {
            "id": "accept",
            "label": "Take the bits.",
            "outcomes": [
              {
                "effects": [{ "op": "gainBits", "amount": 20 }],
                "next": "bits"
              }
            ]
          },
          {
            "id": "refuse-the-debt",
            "label": "Surely it must be a trap!",
            "outcomes": [{ "next": "flee" }]
          }
        ]
      },
      "bits": {
        "text": "It must not understand what a favor actually is.  Weren't *you* supposed to pay *it* back?",
        "choices": [
          {
            "id": "leave",
            "label": "Dumb, haunted machine",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      },
      "flee": {
        "text": "Neither you nor your men are foolish enough to take the bits.  Instead, you take the safer option and run.",
        "choices": [
          {
            "id": "leave",
            "label": "Discretion is the better part of valor, isn't it?",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      }
    }
  },
  {
    "id": "silent-mage",
    "name": "The Silent Mage",
    "entry": "start",
    "pages": {
      "start": {
        "text": "You come upon a mage, silently meditating by a shrine.",
        "choices": [
          {
            "id": "try-to-recruit-him",
            "label": "Try to recruit him",
            "outcomes": [{ "next": "decision" }]
          },
          {
            "id": "join-in-meditation",
            "label": "Join in meditation",
            "outcomes": [
              { "next": "happy" },
              { "next": "quiet" }
            ]
          }
        ]
      },
      "decision": {
        "text": "The mage glares at both you and your band of men.",
        "choices": [
          {
            "id": "oh-no",
            "label": "Oh no...",
            "outcomes": [
              { "weight": 4, "next": "angered" },
              { "weight": 1, "next": "unamused" }
            ]
          }
        ]
      },
      "angered": {
        "text": "The mage signs out a hex and vanishes in a puff of smoke!",
        "choices": [
          {
            "id": "ouch",
            "label": "Ouch",
            "outcomes": [
              {
                "effects": [{ "op": "damagePool", "amount": 2 }],
                "next": { "kind": "return-to-map" }
              }
            ]
          }
        ]
      },
      "unamused": {
        "text": "The mage sighs, less angry than disappointed, and wanders off.",
        "choices": [
          {
            "id": "at-least-he-didn-t-attack-us",
            "label": "At least he didn't attack us",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      },
      "happy": {
        "text": "The mage walks over and sits down amongst your men, a slight smile on his face.",
        "choices": [
          {
            "id": "welcome-to-the-crew",
            "label": "Welcome to the crew!",
            "outcomes": [
              {
                "effects": [{ "op": "grantUnit", "archetype": "mage", "level": 10 }],
                "next": { "kind": "return-to-map" }
              }
            ]
          }
        ]
      },
      "quiet": {
        "text": "You don't talk to the mage, and the mage doesn't talk to you.",
        "choices": [
          {
            "id": "well-that-was-peaceful",
            "label": "Well, that was peaceful",
            "outcomes": [
              {
                "effects": [{ "op": "healPool", "amount": 1 }],
                "next": { "kind": "return-to-map" }
              }
            ]
          }
        ]
      }
    }
  },
  {
    "id": "prodigy",
    "name": "Talented Farmhand",
    "entry": "start",
    "pages": {
      "start": {
        "text": "Your band stay the night with an elderly farmer.  While there, the farmer's grandson talks some of your men into a sparring session.  The boy lacks any sort of training, but you can't help but notice that he seems to have an intuitive grasp of the blade.",
        "choices": [
          {
            "id": "hey-kid",
            "label": "Hey, kid!",
            "outcomes": [{ "next": "payment" }]
          },
          {
            "id": "that-s-interesting-anyway",
            "label": "That's interesting.  Anyway...",
            "outcomes": [{ "next": "no" }]
          }
        ]
      },
      "payment": {
        "text": "The boy darts away to pack his bags before you can even finish your spiel.  His grandfather, though, looks far less enthused.",
        "choices": [
          {
            "id": "perhaps-some-bits-will-cheer-him-up",
            "label": "Perhaps some bits will cheer him up",
            "condition": { "kind": "bitsAtLeast", "amount": 25 },
            "outcomes": [
              {
                "effects": [{ "op": "spendBits", "amount": 25 }],
                "next": "join"
              }
            ]
          },
          {
            "id": "on-second-thought",
            "label": "On second thought...",
            "outcomes": [{ "next": "cheap" }]
          }
        ]
      },
      "join": {
        "text": "A smile breaks out across the old farmer's face, second only to the one on the boy's.",
        "choices": [
          {
            "id": "welcome-to-the-team",
            "label": "Welcome to the team!",
            "outcomes": [
              {
                "effects": [{ "op": "grantUnit", "archetype": "prodigy", "level": 3 }],
                "next": { "kind": "return-to-map" }
              }
            ]
          }
        ]
      },
      "cheap": {
        "text": "The boy, crestfallen, begins to argue with his grandfather.  Better to leave them to it.",
        "choices": [
          {
            "id": "leave",
            "label": "Leave",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      },
      "no": {
        "text": "A band of adventurers is no place for a teenager.",
        "choices": [
          {
            "id": "leave",
            "label": "Leave",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      }
    }
  },
  {
    "id": "mines",
    "name": "The Mining Job",
    "entry": "start",
    "pages": {
      "start": {
        "text": "You and your men come across a notice board, with a listing for \"able-bodied men who know their way around a pickaxe.\"  There are no other details.",
        "choices": [
          {
            "id": "we-can-do-that",
            "label": "We can do that!",
            "outcomes": [{ "next": "accept" }]
          },
          {
            "id": "how-about-no",
            "label": "How about no?",
            "outcomes": [{ "next": "no" }]
          }
        ]
      },
      "no": {
        "text": "There's no way that's worth it.",
        "choices": [
          {
            "id": "leave",
            "label": "Leave",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      },
      "accept": {
        "text": "You all report to the mines.  The foreman hands out the promised pickaxes and grunts, \"Start digging.\"",
        "choices": [
          {
            "id": "dig",
            "label": "Dig",
            "outcomes": [{ "next": "dig1" }]
          }
        ]
      },
      "dig1": {
        "text": "Hours pass.  Nobody has brought you any water.",
        "choices": [
          {
            "id": "keep-digging",
            "label": "Keep digging",
            "outcomes": [
              {
                "effects": [{ "op": "damagePool", "amount": 1 }],
                "next": "dig2"
              }
            ]
          },
          {
            "id": "quit",
            "label": "Quit",
            "outcomes": [{ "next": "quit" }]
          }
        ]
      },
      "dig2": {
        "text": "Some of your men are beginning to suffer from heat stroke.",
        "choices": [
          {
            "id": "keep-digging",
            "label": "Keep digging",
            "outcomes": [
              {
                "effects": [{ "op": "damagePool", "amount": 2 }],
                "next": "dig3"
              }
            ]
          },
          {
            "id": "quit",
            "label": "Quit",
            "outcomes": [{ "next": "quit" }]
          }
        ]
      },
      "dig3": {
        "text": "A strange gas begins to fill the mines, killing the canaries.",
        "choices": [
          {
            "id": "keep-digging",
            "label": "Keep digging",
            "outcomes": [
              {
                "effects": [{ "op": "damagePool", "amount": 3 }],
                "next": "done"
              }
            ]
          },
          {
            "id": "quit",
            "label": "Quit",
            "outcomes": [{ "next": "quit" }]
          }
        ]
      },
      "done": {
        "text": "At last the foreman ends the shift.  He collects your pickaxes and presses a small leaden idol into your hands.  It is heavier than it should be.",
        "choices": [
          {
            "id": "well-it-s-something",
            "label": "Well, it's something",
            "outcomes": [
              {
                "effects": [{ "op": "addDaemon", "daemonId": "dis-pater" }],
                "next": { "kind": "return-to-map" }
              }
            ]
          }
        ]
      },
      "quit": {
        "text": "There's no way this is worth it.  You all collectively abandon the mines.",
        "choices": [
          {
            "id": "leave",
            "label": "Leave",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      }
    }
  },
  {
    "id": "cheese-tax",
    "name": "The Cheese Tax",
    "repeatable": true,
    "entry": "start",
    "pages": {
      "start": {
        "text": "A small dog scurries up to you.  \"Kindly pay the cheese tax,\" it says.",
        "choices": [
          {
            "id": "did-that-dog-just-talk",
            "label": "Did that dog just talk!?",
            "outcomes": [{ "next": "flee" }]
          },
          {
            "id": "will-bits-do-instead",
            "label": "Will bits do instead?",
            "condition": { "kind": "bitsAtLeast", "amount": 10 },
            "outcomes": [
              {
                "effects": [{ "op": "spendBits", "amount": 10 }],
                "next": "pay"
              }
            ]
          }
        ]
      },
      "flee": {
        "text": "\"Demon!\" one of your men shouts.  All hell breaks loose as your men flee, leaving in their wake a very sad little mutt.",
        "choices": [
          {
            "id": "leave",
            "label": "Leave",
            "outcomes": [{ "next": { "kind": "return-to-map" } }]
          }
        ]
      },
      "pay": {
        "text": "\"Money can be exchanged for cheese,\" it says.  The dog flops on its back and lets your men rub its belly.",
        "choices": [
          {
            "id": "that-was-therapeutic",
            "label": "That was therapeutic!",
            "outcomes": [
              {
                "effects": [{ "op": "healPool", "amount": 2 }],
                "next": { "kind": "return-to-map" }
              }
            ]
          }
        ]
      }
    }
  },
  {
    "id": "cadre-1",
    "name": "The Cadre",
    "entry": "start",
    "pages": {
      "start": {
        "text": "A young woman is quite literally preaching on a soapbox in the middle of the square of the village you all are staying in.  Her tirade bounces around from landlords to kulaks to imperialism, but none of the peasants seem particularly interested.",
        "choices": [
          {
            "id": "best-put-a-stop-to-this-now",
            "label": "Best put a stop to this now",
            "outcomes": [{ "next": "shoo" }]
          },
          {
            "id": "take-one-of-her-flyers",
            "label": "Take one of her flyers",
            "outcomes": [{ "next": "listen" }]
          }
        ]
      },
      "shoo": {
        "text": "Your men surround the woman and begin to shuffle her out of the village square.  She makes a scene of it, calling you a class traitor, whatever that means.  The villagers look relieved, however, and one even rewards you with a few bits.",
        "choices": [
          {
            "id": "all-s-well-that-ends-well",
            "label": "All's well that ends well",
            "outcomes": [
              {
                "effects": [{ "op": "gainBits", "amount": 5 }],
                "next": { "kind": "return-to-map" }
              }
            ]
          }
        ]
      },
      "listen": {
        "text": "\"Thank you, comrades!\" she shouts, before turning back to her proselytizing.  The pamphlet is a dense tome about dialectics which makes your eyes glaze over.",
        "choices": [
          {
            "id": "can-the-villagers-even-read-this",
            "label": "Can the villagers even read this?",
            "outcomes": [
              {
                "effects": [{ "op": "setFlag", "flag": "cadre:read" }],
                "next": { "kind": "return-to-map" }
              }
            ]
          }
        ]
      }
    }
  },
  {
    "id": "cadre-2",
    "name": "The Cadre, Part Two",
    "eligibility": [{ "kind": "flagSet", "flag": "cadre:read" }],
    "entry": "start",
    "pages": {
      "start": {
        "text": "You come across a village in disarray.  A group of guerillas are locked in a standoff with the village priest.  Leading the guerillas is none other than the young woman who'd been ranting on a soapbox some hops ago.\n\n\"Comrades,\" she addresses you.  \"This temple has leached off of the poor for long enough.  Help us burn it down!\"\n\n\"But it's full of plague victims,\" pleads the priest.  ",
        "choices": [
          {
            "id": "help-the-guerillas",
            "label": "Help the guerillas",
            "outcomes": [
              {
                "effects": [{ "op": "setFlag", "flag": "cadre:arson" }],
                "next": {
                  "kind": "start-encounter",
                  "encounterId": "plagueVictims"
                }
              }
            ]
          },
          {
            "id": "defend-the-priest",
            "label": "Defend the priest",
            "outcomes": [{ "next": "defend" }]
          }
        ]
      },
      "defend": {
        "text": "\"Sabateur!\" hisses the woman.  Before you can engage, she and her posse flee.  The priest thanks you, and presses a few bits into your hand.\n\n\"Would that we had more to give, but we can barely pay for medicine.\"",
        "choices": [
          {
            "id": "leave",
            "label": "Leave",
            "outcomes": [
              {
                "effects": [{ "op": "gainBits", "amount": 10 }],
                "next": { "kind": "return-to-map" }
              }
            ]
          }
        ]
      }
    }
  },
  {
    "id": "cadre-3",
    "name": "The Cadre, Part Three",
    "eligibility": [{ "kind": "flagSet", "flag": "cadre:arson" }],
    "entry": "start",
    "pages": {
      "start": {
        "text": "Your band arrives at the local county seat and finds a city in chaos.  Squads of men wearing red armbands run rampant, looting anything that looks even vaguely edible.  Or valuable, for that matter.\n\n\"Comrades,\" shouts a familiar voice, \"We're evacuating the city before imperial forces besiege us.  Help us!\"",
        "choices": [
          {
            "id": "help-with-requisitioning-supplies",
            "label": "Help with requisitioning supplies",
            "outcomes": [{ "next": "loot" }]
          },
          {
            "id": "evacuate-the-civilians",
            "label": "Evacuate the civilians",
            "outcomes": [{ "next": "help" }]
          }
        ]
      },
      "loot": {
        "text": "Your men join in with the guerillas.  There's not much to be found that hasn't already been looted, but you do come across an idol in a burned-out hut.",
        "choices": [
          {
            "id": "not-our-finest-hour",
            "label": "Not our finest hour",
            "outcomes": [
              {
                "effects": [{ "op": "addDaemon", "daemonId": "moneta" }],
                "next": { "kind": "return-to-map" }
              }
            ]
          }
        ]
      },
      "help": {
        "text": "The woman looks at you as if that were the dumbest idea she's ever heard.  She does not, however, stop you.",
        "choices": [
          {
            "id": "evacuate-the-city-center",
            "label": "Evacuate the city center",
            "outcomes": [{ "next": "downtown" }]
          },
          {
            "id": "evacuate-the-outskirts",
            "label": "Evacuate the outskirts",
            "outcomes": [{ "next": "outskirts" }]
          }
        ]
      },
      "downtown": {
        "text": "You find a group of bureaucrats in the basement of the city hall; apparently they've in hiding since the guerillas seized control.",
        "choices": [
          {
            "id": "follow-us",
            "label": "Follow us!",
            "outcomes": [{ "next": "escape" }]
          }
        ]
      },
      "escape": {
        "text": "You get the bureaucrats to safety with minimal difficulty.  They reward you handsomely.",
        "choices": [
          {
            "id": "all-in-a-day-s-work",
            "label": "All in a day's work",
            "outcomes": [
              {
                "effects": [{ "op": "gainBits", "amount": 50 }],
                "next": { "kind": "return-to-map" }
              }
            ]
          }
        ]
      },
      "outskirts": {
        "text": "You arrive at the outskirts to find an advanced column of government forces.  They don't look particularly friendly.",
        "choices": [
          {
            "id": "to-arms",
            "label": "To arms!",
            "outcomes": [
              {
                "next": {
                  "kind": "start-encounter",
                  "encounterId": "infernalColumn",
                  "rewardOverride": [
                    { "table": "bits-large", "trigger": { "chance": 1 } },
                    { "table": "packets-elite", "trigger": { "chance": 0.5 } },
                    { "table": "daemons", "trigger": { "chance": 1 } }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  },
  {
    "id": "orange-mob",
    "name": "Orange Mob",
    "entry": "start",
    "pages": {
      "start": {
        "text": "Your band comes across a small mob.  They appear to all be short, orange, and musically inclined.  And they appear to be drowning a boy in a river full of...\n\nWait, chocolate?",
        "choices": [
          {
            "id": "best-not-get-involved",
            "label": "Best not get involved",
            "outcomes": [{ "next": "nope" }]
          },
          {
            "id": "save-the-boy",
            "label": "Save the boy",
            "outcomes": [{ "next": "help" }]
          }
        ]
      },
      "nope": {
        "text": "You detour around the singing lynch mob and instead sample the chocolate river.",
        "choices": [
          {
            "id": "delicious",
            "label": "Delicious!",
            "outcomes": [
              {
                "effects": [{ "op": "healPool", "amount": 4 }],
                "next": { "kind": "return-to-map" }
              }
            ]
          }
        ]
      },
      "help": {
        "text": "The little, orange men scatter.  The boy thanks you profusely and offers you a small reward.",
        "choices": [
          {
            "id": "happy-to-help-lad",
            "label": "Happy to help, lad",
