        {
          "kind": "hook",
          "on": "turnStart",
          "effect": {
            "op": "grantRedraws",
            "redrawsPerTurn": 1,
            "maxCardsPerTurn": 4
          }
        }
      ]
    },
    {
      "id": "moneta",
      "name": "Scales of Moneta",
      "description": "All bits earned are increased by 20%.",
